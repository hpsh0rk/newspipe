{
  "theme": "light",
  "version": "1.0",
  "name": "Ocean Minimalist",
  "description": "轻盈通透的浅色画布 + 高饱和科技蓝单点强调。留白充裕、层级分明, 读起来是「干净、可靠、不喧哗」的效率工具气质 —— 信息密度中等, 视觉呼吸感优先, 强调色稀缺到几乎只出现在主 CTA 上。",
  "feel": [
    "轻盈",
    "通透",
    "可靠",
    "不喧哗",
    "呼吸感"
  ],
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.3, 0, 0, 1.15)"
    }
  },
  "interaction": {
    "hoverChannel": "color",
    "focusChannel": "ring"
  },
  "colors": {
    "primary": "#2563EB",
    "primaryHover": "#1D4ED8",
    "primaryActive": "#1E40AF",
    "primarySubtle": "#EFF6FF",
    "secondary": "#0284C7",
    "secondaryHover": "#0369A1",
    "accent": "#38BDF8",
    "background": "#F8FAFC",
    "surface": "#FFFFFF",
    "surfaceHover": "#F1F5F9",
    "card": "#FFFFFF",
    "textPrimary": "#0F172A",
    "textSecondary": "#64748B",
    "textTertiary": "#94A3B8",
    "border": "#E2E8F0",
    "borderHover": "#CBD5E1",
    "divider": "#F1F5F9",
    "onPrimary": "#FFFFFF",
    "focusRing": "#93C5FD",
    "semantic": {
      "success": {
        "bg": "#ECFDF5",
        "border": "#A7F3D0",
        "text": "#065F46"
      },
      "warning": {
        "bg": "#FFFBEB",
        "border": "#FDE68A",
        "text": "#92400E"
      },
      "error": {
        "bg": "#FEF2F2",
        "border": "#FECACA",
        "text": "#991B1B"
      },
      "info": {
        "bg": "#EFF6FF",
        "border": "#BFDBFE",
        "text": "#1E40AF"
      }
    }
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
    "monoFontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
    "fontSizes": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px"
    },
    "lineHeights": {
      "tight": "1.25",
      "normal": "1.5",
      "relaxed": "1.75"
    },
    "fontWeights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "icons": {
    "library": "Lucide Icons / Heroicons",
    "strokeWidth": 1.75,
    "sizes": {
      "sm": 16,
      "md": 20,
      "lg": 24,
      "xl": 32
    }
  },
  "spacing": {
    "xxs": "4px",
    "xs": "8px",
    "sm": "12px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "xxl": "48px",
    "section": "96px"
  },
  "rounded": {
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "xxl": "24px",
    "pill": "9999px",
    "full": "9999px"
  },
  "components": {
    "button": {
      "states": {
        "default": {
          "bg": "{colors.primary}",
          "text": "{colors.onPrimary}",
          "border": "transparent",
          "shadow": "0 1px 2px rgba(0,0,0,0.05)"
        },
        "hover": {
          "bg": "{colors.primaryHover}",
          "text": "{colors.onPrimary}",
          "border": "transparent",
          "shadow": "0 2px 4px rgba(37,99,235,0.2)"
        },
        "active": {
          "bg": "{colors.primaryActive}",
          "text": "{colors.onPrimary}",
          "border": "transparent",
          "shadow": "none"
        },
        "focus": {
          "bg": "{colors.primary}",
          "text": "{colors.onPrimary}",
          "border": "{colors.focusRing}",
          "ring": "0 0 0 3px rgba(37,99,235,0.3)"
        },
        "disabled": {
          "bg": "{colors.border}",
          "text": "{colors.textTertiary}",
          "border": "transparent",
          "cursor": "not-allowed"
        },
        "loading": {
          "bg": "{colors.primary}",
          "text": "{colors.onPrimary}",
          "border": "transparent",
          "cursor": "progress",
          "spinner": "{colors.onPrimary}"
        }
      }
    },
    "input": {
      "states": {
        "default": {
          "bg": "{colors.surface}",
          "border": "{colors.borderHover}",
          "text": "{colors.textPrimary}",
          "placeholder": "{colors.textTertiary}"
        },
        "hover": {
          "bg": "{colors.surface}",
          "border": "{colors.textTertiary}",
          "text": "{colors.textPrimary}",
          "placeholder": "{colors.textSecondary}"
        },
        "focus": {
          "bg": "{colors.surface}",
          "border": "{colors.primary}",
          "text": "{colors.textPrimary}",
          "ring": "0 0 0 3px rgba(37,99,235,0.15)"
        },
        "error": {
          "bg": "{colors.semantic.error.bg}",
          "border": "#EF4444",
          "text": "{colors.semantic.error.text}",
          "ring": "0 0 0 3px rgba(239,68,68,0.15)"
        },
        "disabled": {
          "bg": "{colors.surfaceHover}",
          "border": "{colors.border}",
          "text": "{colors.textTertiary}",
          "cursor": "not-allowed"
        }
      }
    },
    "card": {
      "states": {
        "default": {
          "bg": "{colors.surface}",
          "border": "{colors.border}",
          "shadow": "0 1px 3px rgba(0,0,0,0.05)"
        },
        "hover": {
          "bg": "{colors.surface}",
          "border": "{colors.borderHover}",
          "shadow": "0 4px 6px -1px rgba(0,0,0,0.1)"
        }
      }
    },
    "badge": {
      "states": {
        "default": {
          "bg": "{colors.surfaceHover}",
          "text": "#475569",
          "border": "{colors.border}"
        },
        "success": {
          "bg": "{colors.semantic.success.bg}",
          "text": "{colors.semantic.success.text}",
          "border": "{colors.semantic.success.border}"
        },
        "warning": {
          "bg": "{colors.semantic.warning.bg}",
          "text": "{colors.semantic.warning.text}",
          "border": "{colors.semantic.warning.border}"
        },
        "error": {
          "bg": "{colors.semantic.error.bg}",
          "text": "{colors.semantic.error.text}",
          "border": "{colors.semantic.error.border}"
        }
      }
    },
    "checkbox": {
      "states": {
        "default": {
          "bg": "{colors.surface}",
          "border": "{colors.borderHover}",
          "text": "{colors.textPrimary}"
        },
        "checked": {
          "bg": "{colors.primary}",
          "border": "{colors.primary}",
          "text": "{colors.onPrimary}"
        },
        "indeterminate": {
          "bg": "{colors.primary}",
          "border": "{colors.primary}",
          "text": "{colors.onPrimary}"
        },
        "disabled": {
          "bg": "{colors.surfaceHover}",
          "border": "{colors.border}",
          "text": "{colors.textTertiary}",
          "cursor": "not-allowed"
        }
      }
    },
    "link": {
      "states": {
        "default": {
          "text": "{colors.primary}",
          "decoration": "none"
        },
        "hover": {
          "text": "{colors.primaryHover}",
          "decoration": "underline"
        },
        "active": {
          "text": "{colors.primaryActive}",
          "decoration": "underline"
        }
      }
    },
    "nav": {
      "states": {
        "default": {
          "bg": "{colors.background}",
          "text": "{colors.textSecondary}",
          "border": "{colors.border}",
          "height": "56px",
          "zIndex": "{zIndex.sticky}"
        },
        "linkHover": {
          "text": "{colors.primary}",
          "decoration": "none"
        },
        "linkActive": {
          "text": "{colors.textPrimary}",
          "indicator": "{colors.primary}"
        },
        "sticky": {
          "bg": "{colors.surface}",
          "border": "{colors.border}",
          "zIndex": "{zIndex.sticky}",
          "backdropFilter": "{scrim.blur}"
        }
      }
    },
    "footer": {
      "states": {
        "default": {
          "bg": "{colors.background}",
          "text": "{colors.textSecondary}",
          "border": "{colors.border}"
        },
        "linkHover": {
          "text": "{colors.textPrimary}",
          "decoration": "underline"
        }
      }
    },
    "modal": {
      "states": {
        "overlay": {
          "bg": "{scrim.color}",
          "backdropFilter": "{scrim.blur}",
          "zIndex": "{zIndex.overlay}"
        },
        "default": {
          "bg": "{colors.surface}",
          "text": "{colors.textPrimary}",
          "border": "{colors.border}",
          "rounded": "{rounded.lg}",
          "zIndex": "{zIndex.modal}"
        },
        "close": {
          "text": "{colors.textSecondary}",
          "hoverText": "{colors.textPrimary}"
        }
      }
    },
    "drawer": {
      "states": {
        "overlay": {
          "bg": "{scrim.color}",
          "backdropFilter": "{scrim.blur}",
          "zIndex": "{zIndex.overlay}"
        },
        "default": {
          "bg": "{colors.surface}",
          "text": "{colors.textPrimary}",
          "border": "{colors.border}",
          "zIndex": "{zIndex.modal}"
        }
      }
    },
    "toast": {
      "states": {
        "default": {
          "bg": "{colors.surface}",
          "text": "{colors.textPrimary}",
          "border": "{colors.border}",
          "rounded": "{rounded.md}",
          "zIndex": "{zIndex.toast}"
        },
        "success": {
          "bg": "{colors.semantic.success.bg}",
          "text": "{colors.semantic.success.text}",
          "border": "{colors.semantic.success.border}",
          "zIndex": "{zIndex.toast}"
        },
        "warning": {
          "bg": "{colors.semantic.warning.bg}",
          "text": "{colors.semantic.warning.text}",
          "border": "{colors.semantic.warning.border}",
          "zIndex": "{zIndex.toast}"
        },
        "error": {
          "bg": "{colors.semantic.error.bg}",
          "text": "{colors.semantic.error.text}",
          "border": "{colors.semantic.error.border}",
          "zIndex": "{zIndex.toast}"
        }
      }
    },
    "tooltip": {
      "states": {
        "default": {
          "bg": "{colors.textPrimary}",
          "text": "{colors.background}",
          "rounded": "{rounded.sm}",
          "zIndex": "{zIndex.popover}"
        }
      }
    },
    "table": {
      "states": {
        "header": {
          "bg": "{colors.surfaceHover}",
          "text": "{colors.textSecondary}",
          "border": "{colors.border}"
        },
        "rowDefault": {
          "bg": "{colors.surface}",
          "text": "{colors.textPrimary}",
          "border": "{colors.border}"
        },
        "rowHover": {
          "bg": "{colors.surfaceHover}",
          "text": "{colors.textPrimary}",
          "border": "{colors.border}"
        },
        "rowSelected": {
          "bg": "{colors.primarySubtle}",
          "text": "{colors.textPrimary}",
          "border": "{colors.primary}"
        }
      }
    },
    "tabs": {
      "states": {
        "default": {
          "text": "{colors.textSecondary}",
          "border": "transparent"
        },
        "hover": {
          "text": "{colors.textPrimary}",
          "border": "transparent"
        },
        "active": {
          "text": "{colors.primary}",
          "border": "{colors.primary}"
        }
      }
    },
    "avatar": {
      "states": {
        "default": {
          "bg": "{colors.surfaceHover}",
          "text": "{colors.textSecondary}",
          "rounded": "{rounded.full}"
        },
        "fallback": {
          "bg": "{colors.primarySubtle}",
          "text": "{colors.primary}",
          "rounded": "{rounded.full}"
        }
      }
    },
    "codeBlock": {
      "states": {
        "default": {
          "bg": "{colors.surfaceHover}",
          "text": "{colors.textPrimary}",
          "border": "{colors.border}",
          "rounded": "{rounded.md}",
          "font": "{typography.monoFontFamily}"
        }
      }
    },
    "skeleton": {
      "states": {
        "default": {
          "bg": "{colors.surfaceHover}",
          "rounded": "{rounded.sm}"
        },
        "shimmer": {
          "from": "{colors.surfaceHover}",
          "to": "{colors.border}"
        }
      }
    },
    "emptyState": {
      "states": {
        "default": {
          "icon": "{colors.textTertiary}",
          "title": "{colors.textPrimary}",
          "body": "{colors.textSecondary}"
        }
      }
    }
  },
  "numeric": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
    "fontFeature": "tnum 1, lnum 1",
    "align": "right"
  },
  "zIndex": {
    "base": 0,
    "dropdown": 1000,
    "sticky": 1020,
    "banner": 1030,
    "overlay": 1040,
    "modal": 1050,
    "popover": 1060,
    "toast": 1070
  },
  "scrim": {
    "color": "rgba(0,0,0,0.45)",
    "blur": "8px"
  },
  "grid": {
    "columns": 12,
    "gutter": "{spacing.lg}",
    "maxWidth": "1200px"
  },
  "techStack": {
    "source": "user",
    "framework": "Python http.server 服务端模板",
    "componentLibrary": "纯 CSS 设计系统(零依赖)",
    "styling": "原生 CSS 单文件",
    "motion": "CSS 渐进增强(零JS)",
    "notes": "",
    "evidence": "用户对话比选拍板",
    "decidedAt": "2026-10-07T04:52:27.548Z"
  }
}